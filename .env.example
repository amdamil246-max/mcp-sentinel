# ==============================================================================
# MCP SENTINEL CONFIGURATION ENVIRONMENT TEMPLATE
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default for zero-setup, PostgreSQL for production)
DATABASE_URL=sqlite:///./sentinel.db
# DATABASE_URL=postgresql://sentinel:sentinel_secure_password@localhost:5432/mcp_sentinel

# Distributed Cache & WebSockets (Optional in development, required in cluster mode)
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography
SECRET_KEY=sentinel_dev_secret_key_change_in_production_32_bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Risk Engine Thresholds (0-100 scale)
AUTO_BLOCK_THRESHOLD=80
REQUIRE_APPROVAL_THRESHOLD=50
APPROVAL_EXPIRATION_SECONDS=300

# Anomaly Velocity Thresholds
VELOCITY_WINDOW_SECONDS=60
MAX_INVOCATIONS_PER_WINDOW=30
CONSECUTIVE_BLOCK_THRESHOLD=3

# External LLM Advisory Engine (Optional: system provides deterministic heuristic fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_MODEL_ENDPOINT=http://localhost:11434/api/generate
